# ================================================================
# FRONTEND ENVIRONMENT VARIABLES (TEMPLATE)
# ================================================================
# Copy this file to `.env` and fill in your values:
#     cp .env.example .env
# NEVER commit the real `.env`. See .gitignore.
#
# SECURITY: every VITE_* variable is embedded into the PUBLIC browser
# bundle. Never put secrets (API keys, tokens) behind a VITE_ variable.
# ================================================================

# ----- Domain & API ------------------------------------------------
VITE_DOMAIN=maskani.my.id
VITE_API_BASE_URL=http://localhost:4000/api

# ----- Feature Flags -----------------------------------------------
# Set to false to hide the AI assistant FAB
VITE_ENABLE_AI=true

# Google reCAPTCHA v2 site key (optional, client-side only)
VITE_RECAPTCHA_SITE_KEY=

# Google Analytics 4 Measurement ID (optional)
VITE_GA_ID=
